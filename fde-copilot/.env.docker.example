# Copy to `.env.docker` (same directory) — compose loads it via `env_file:` and injects every key
# below into the container. Without that file the container falls back to the defaults in
# docker-compose.yml. `.env.docker` is gitignored; never commit real tokens.

# Optional model override. Leave empty to use the subscription default.
# CLAUDE_MODEL=

# Model routing. The UI can override this per project.
FDE_DEFAULT_PROVIDER=claude
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct-mlx
# LMSTUDIO_API_KEY=  # only when LM Studio authentication is enabled

# Maximum turns the agent may take for one customer message.
AGENT_MAX_TURNS=40

# Keep false unless this container has a configured Git remote and credentials.
AUTO_COMMIT=false
AUTO_PUSH=false

# Shared secret for the API. Auth is FAIL-OPEN when this is empty: anyone who can reach the port
# can read and write every client's specs. Compose binds to 127.0.0.1 by default, so an empty value
# is only acceptable for a purely local, single-user setup.
# REQUIRED whenever you set FDE_COPILOT_BIND to anything other than 127.0.0.1.
# WORKBENCH_TOKEN=

# Host interface the published port binds to. Keep 127.0.0.1 unless you have set WORKBENCH_TOKEN
# above — 0.0.0.0 exposes the service (and all client specs) to every host on the LAN.
# FDE_COPILOT_BIND=127.0.0.1
